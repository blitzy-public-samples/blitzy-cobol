<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherit from the cobol-parent aggregator POM. The parent supplies the
        Spring Boot 3.5.9 BOM (via its own spring-boot-starter-parent), Java 21
        source/target/release, the zero-warning compiler policy (-Xlint:all
        -Werror -parameters), the UTF-8 surefire encoding and the pre-bound
        spring-boot-maven-plugin repackage goal. groupId and version are inherited
        from this parent and are therefore intentionally omitted below.
        relativePath resolves the parent from the repository root on the local
        filesystem rather than from a remote repository.
    -->
    <parent>
        <groupId>com.projectcobol</groupId>
        <artifactId>cobol-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cobol-sort</artifactId>

    <name>Project COBOL - Sort</name>
    <description>
        Java 21 / Spring Boot 3.x translation of OpenCobol/Sort/*.cbl. Provides three
        sorting-algorithm demonstrations: BubbleSortApplication (int[10], range [1,99],
        nested compare/swap via W-TEMP), InsertSortApplication (int[20], range [1,99],
        W-KEY-based shift insertion), and SelectSortApplication (int[30], range [1,200],
        W-MIN/W-SWAP selection). Production code seeds java.util.Random with
        System.currentTimeMillis() % 86400 to mirror the COBOL FUNCTION
        SECONDS-PAST-MIDNIGHT seeding; tests inject a fixed long seed via a
        package-private constructor for deterministic golden-output assertions. The
        three entry classes share the single fat-jar cobol-sort-1.0.0.jar; the default
        mainClass is BubbleSortApplication. Use -Dloader.main=com.projectcobol.sort.InsertSortApplication
        (or SelectSortApplication) to run a non-default entry class.
    </description>

    <!--
        Exactly two dependencies, both BOM-managed (no explicit version): the core
        Spring Boot starter that provides SpringApplication, CommandLineRunner and
        the @SpringBootApplication auto-configuration used by the three sort entry
        classes (BubbleSortApplication, InsertSortApplication, SelectSortApplication),
        and the test starter (JUnit Jupiter 5.12.x, AssertJ, Mockito, spring-boot-test)
        that backs the seed-injected JUnit 5 golden-output tests for this module. This
        module is self-contained: it adds no JDBC driver and depends on no other
        cobol-* sub-module.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        finalName fixes the executable artifact path to
        target/cobol-sort-1.0.0.jar so the documented run command
        (java -jar cobol-sort/target/cobol-sort-1.0.0.jar) works. The
        spring-boot-maven-plugin is referenced without a version (managed by the
        parent) and without an executions block (the repackage goal is already
        bound in the parent's pluginManagement). This module has three
        @SpringBootApplication entry classes, so mainClass is pinned to the
        alphabetically-first one (BubbleSortApplication). This gives the fat-jar a
        single, deterministic Start-Class and avoids the repackage failure that
        occurs when multiple main classes are found. InsertSortApplication and
        SelectSortApplication are documented in the root README as alternate
        entry points.
    -->
    <build>
        <finalName>cobol-sort-1.0.0</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.projectcobol.sort.BubbleSortApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
