<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherit from the cobol-parent aggregator POM. The parent supplies the
        Spring Boot 3.5.x BOM (via its own spring-boot-starter-parent), Java 21
        source/target/release, the zero-warning compiler policy (-Xlint:all,
        -Werror, -parameters), the UTF-8 surefire encoding and the pre-bound
        spring-boot-maven-plugin repackage goal. groupId and version are inherited
        from this parent and are therefore intentionally omitted below.
        relativePath resolves the parent from the repository root on the local
        filesystem rather than from a remote repository.
    -->
    <parent>
        <groupId>com.projectcobol</groupId>
        <artifactId>cobol-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cobol-conditions</artifactId>
    <packaging>jar</packaging>

    <name>Project COBOL - Conditions</name>
    <description>
        Java 21 / Spring Boot 3.x translations of the eight COBOL programs in
        OpenCobol/Conditions/. Demonstrates COBOL predicate patterns translated
        into idiomatic Java: class conditions (ALPHABETIC/NUMERIC), combined
        conditions (AND/OR/NOT), condition-name conditions (88-level VALUE THRU
        ranges), nested IF/ELSE statements, EVALUATE TRUE switching, negated
        relational conditions, relational comparisons (&gt;=, &lt;=), and sign
        conditions (POSITIVE/NEGATIVE/ZERO).
    </description>

    <!--
        Exactly two dependencies, both BOM-managed (no explicit version): the core
        Spring Boot starter that provides SpringApplication, CommandLineRunner and
        the @SpringBootApplication auto-configuration used by the eight Conditions
        entry classes, and the test starter (JUnit Jupiter 5.12.x, AssertJ, Mockito,
        spring-boot-test) that backs the JUnit 5 golden-output tests for this module.
        This module is self-contained: it adds no JDBC driver and depends on no other
        cobol-* sub-module.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        Multiple-entry-class strategy (Option A per the cobol-conditions module
        specification): this sub-module contains eight @SpringBootApplication
        classes that all share the single executable fat-jar
        cobol-conditions-1.0.0.jar. The default Start-Class is
        ClassConditionApplication (alphabetically first), pinned below through the
        start-class property and wired into the spring-boot-maven-plugin mainClass.

        layout=ZIP packages the jar with Spring Boot's PropertiesLauncher as the
        Main-Class (instead of the default JarLauncher). PropertiesLauncher honours
        the loader.main system property, so any of the other seven entry classes can
        be selected at run time from the SAME jar after a single `mvn clean package`,
        with no rebuild required:

            java -Dloader.main=com.projectcobol.conditions.CombinedConditionsApplication \
                 -jar target/cobol-conditions-1.0.0.jar

            java -Dloader.main=com.projectcobol.conditions.ConditionNameConditionApplication \
                 -jar target/cobol-conditions-1.0.0.jar

            java -Dloader.main=com.projectcobol.conditions.ConditionStatementApplication \
                 -jar target/cobol-conditions-1.0.0.jar

            java -Dloader.main=com.projectcobol.conditions.EvaluteVerbApplication \
                 -jar target/cobol-conditions-1.0.0.jar

            java -Dloader.main=com.projectcobol.conditions.NegatedConditionApplication \
                 -jar target/cobol-conditions-1.0.0.jar

            java -Dloader.main=com.projectcobol.conditions.RelationConditionApplication \
                 -jar target/cobol-conditions-1.0.0.jar

            java -Dloader.main=com.projectcobol.conditions.SignConditionApplication \
                 -jar target/cobol-conditions-1.0.0.jar

        Without -Dloader.main, PropertiesLauncher falls back to the manifest
        Start-Class (ClassConditionApplication). Alternatively, bake a different
        default into the jar by overriding the start-class property at build time:

            mvn clean package -Dstart-class=com.projectcobol.conditions.EvaluteVerbApplication

        NOTE: each @SpringBootApplication entry class restricts its own component
        scanning so that exactly one COBOL Conditions translation runs per
        invocation; that runtime isolation lives in the Java sources, not in this POM.
    -->
    <properties>
        <start-class>com.projectcobol.conditions.ClassConditionApplication</start-class>
    </properties>

    <!--
        finalName fixes the executable artifact path to
        target/cobol-conditions-1.0.0.jar so the documented run command
        (java -jar cobol-conditions/target/cobol-conditions-1.0.0.jar) works. The
        spring-boot-maven-plugin is referenced without a version (managed by the
        parent) and without an executions block (the repackage goal is already bound
        in the parent's pluginManagement). mainClass is wired to the start-class
        property so the default Start-Class is ClassConditionApplication, and
        layout=ZIP selects the PropertiesLauncher that honours -Dloader.main for the
        other seven entry classes (see the run examples above).
    -->
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <layout>ZIP</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
