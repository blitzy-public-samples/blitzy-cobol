<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherit from the cobol-parent aggregator POM. The parent supplies the
        Spring Boot 3.5.x BOM (via its own spring-boot-starter-parent), Java 21
        source/target/release, the zero-warning compiler policy (-Xlint:all
        -Werror -parameters), the UTF-8 surefire encoding and the pre-bound
        spring-boot-maven-plugin repackage goal. groupId and version are inherited
        from this parent and are therefore intentionally omitted below.
        relativePath resolves the parent from the repository root on the local
        filesystem rather than from a remote repository.
    -->
    <parent>
        <groupId>com.projectcobol</groupId>
        <artifactId>cobol-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cobol-string</artifactId>

    <name>Project COBOL - String</name>
    <description>
        Java 21 / Spring Boot 3.x translation of OpenCobol/String/String.cbl.
        Demonstrates COBOL substring reference modification semantics by iterating
        over each character of the literal "HOHOHOHOHO" using PERFORM VARYING and
        the (position:length) reference modification syntax. The Java translation
        uses String.substring with a 1-based-to-0-based offset adjustment to
        reproduce the same character-by-character output exactly.
    </description>

    <!--
        Exactly two dependencies, both BOM-managed (no explicit version): the core
        Spring Boot starter that provides SpringApplication, CommandLineRunner and
        the @SpringBootApplication auto-configuration used by StringApplication, and
        the test starter (JUnit Jupiter 5.12.x, AssertJ, Mockito, spring-boot-test)
        that backs the JUnit 5 golden-output test for this module. This module is
        self-contained: it adds no JDBC driver and depends on no other cobol-* sub-module.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        finalName fixes the executable artifact path to
        target/cobol-string-1.0.0.jar so the documented run command
        (java -jar cobol-string/target/cobol-string-1.0.0.jar) works. The
        spring-boot-maven-plugin is referenced without a version (managed by the
        parent) and without an executions block (the repackage goal is already
        bound in the parent's pluginManagement). This module contains exactly one
        @SpringBootApplication entry class; mainClass is pinned explicitly to
        com.projectcobol.string.StringApplication to give the fat-jar a single,
        deterministic Start-Class in its manifest (matching the explicit mainClass
        configuration used across the other cobol-* sub-modules). No layout
        override is needed because there is only one entry class to launch.
    -->
    <build>
        <finalName>cobol-string-1.0.0</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.projectcobol.string.StringApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
