<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherit from the cobol-parent aggregator POM. The parent supplies the
        Spring Boot 3.5.x BOM (via its own spring-boot-starter-parent), Java 21
        source/target/release, the zero-warning compiler policy (-Xlint:all
        -Werror -parameters), the UTF-8 surefire encoding and the pre-bound
        spring-boot-maven-plugin repackage goal. groupId and version are inherited
        from this parent and are therefore intentionally omitted below.
        relativePath resolves the parent from the repository root on the local
        filesystem rather than from a remote repository.
    -->
    <parent>
        <groupId>com.projectcobol</groupId>
        <artifactId>cobol-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cobol-database</artifactId>

    <name>Project COBOL - Database</name>
    <description>
        Java 21 / Spring Boot 3.x translation of the four COBOL programs under
        OpenCobol/Database/: OpenFileRecordKey, OpenFileSequential, SequentialRead,
        and StatusCode. Includes a FileStatus enum encoding the 30 COBOL FILE-STATUS
        codes from StatusCode.cbl. The file-reading translations load the data.txt
        fixture from the classpath via ClassLoader.getResourceAsStream rather than
        the COBOL relative path. The four entry classes share the single fat-jar
        cobol-database-1.0.0.jar; the default mainClass is OpenFileRecordKeyApplication.
        Use -Dloader.main=com.projectcobol.database.OpenFileSequentialApplication
        (or SequentialReadApplication, or StatusCodeApplication) to run a non-default
        entry class.
    </description>

    <!--
        Exactly two dependencies, both BOM-managed (no explicit version): the core
        Spring Boot starter that provides SpringApplication, CommandLineRunner and
        the @SpringBootApplication auto-configuration used by the four database entry
        classes (OpenFileRecordKeyApplication, OpenFileSequentialApplication,
        SequentialReadApplication, StatusCodeApplication), and the test starter
        (JUnit Jupiter 5.12.x, AssertJ, Mockito, spring-boot-test) that backs the
        JUnit 5 golden-output tests for this module. This module is self-contained:
        it reads its flat-file fixture (data.txt) with java.io.BufferedReader over a
        classpath resource, so it needs no JDBC driver, no Spring Web/Data starter,
        and depends on no other cobol-* sub-module.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        finalName fixes the executable artifact path to
        target/cobol-database-1.0.0.jar so the documented run command
        (java -jar cobol-database/target/cobol-database-1.0.0.jar) works. The
        spring-boot-maven-plugin is referenced without a version (managed by the
        parent) and without an executions block (the repackage goal is already
        bound in the parent's pluginManagement). This module has four
        @SpringBootApplication entry classes, so mainClass is pinned to the
        alphabetically-first one (OpenFileRecordKeyApplication). This gives the
        fat-jar a single, deterministic default Start-Class and avoids the repackage
        failure that occurs when multiple main classes are found.

        layout=ZIP packages the jar with Spring Boot's PropertiesLauncher as the
        Main-Class (instead of the default JarLauncher). PropertiesLauncher honours
        the loader.main system property, so the three non-default entry classes can
        be selected at run time from the shared cobol-database-1.0.0.jar:
            java -Dloader.main=com.projectcobol.database.OpenFileSequentialApplication -jar ...
            java -Dloader.main=com.projectcobol.database.SequentialReadApplication -jar ...
            java -Dloader.main=com.projectcobol.database.StatusCodeApplication -jar ...
        Without -Dloader.main, PropertiesLauncher falls back to the manifest
        Start-Class (OpenFileRecordKeyApplication). These run commands are documented
        in the root README.
    -->
    <build>
        <finalName>cobol-database-1.0.0</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.projectcobol.database.OpenFileRecordKeyApplication</mainClass>
                    <layout>ZIP</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
