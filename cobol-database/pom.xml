<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherit from the cobol-parent aggregator POM. The parent supplies the
        Spring Boot 3.5.x BOM (via its own spring-boot-starter-parent), Java 21
        source/target/release, the zero-warning compiler policy (-Xlint:all
        -Werror -parameters), the UTF-8 surefire encoding and the pre-bound
        spring-boot-maven-plugin repackage goal. groupId and version are inherited
        from this parent and are therefore intentionally omitted below.
        relativePath resolves the parent from the repository root on the local
        filesystem rather than from a remote repository.
    -->
    <parent>
        <groupId>com.projectcobol</groupId>
        <artifactId>cobol-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cobol-database</artifactId>

    <name>Project COBOL - Database</name>
    <description>
        Java 21 / Spring Boot 3.x translation of the four COBOL programs under
        OpenCobol/Database/: OpenFileRecordKey, OpenFileSequential, SequentialRead,
        and StatusCode. Includes a FileStatus enum encoding the 30 COBOL FILE-STATUS
        codes from StatusCode.cbl. The file-reading translations load the data.txt
        fixture from the classpath via ClassLoader.getResourceAsStream rather than
        the COBOL relative path. The four entry classes are co-equal with no single
        default; this module pins no mainClass and is built as a plain library JAR
        (see the build section below for the rationale).
    </description>

    <!--
        Exactly two dependencies, both BOM-managed (no explicit version): the core
        Spring Boot starter that provides SpringApplication, CommandLineRunner and
        the @SpringBootApplication auto-configuration used by the four database entry
        classes (OpenFileRecordKeyApplication, OpenFileSequentialApplication,
        SequentialReadApplication, StatusCodeApplication), and the test starter
        (JUnit Jupiter 5.12.x, AssertJ, Mockito, spring-boot-test) that backs the
        JUnit 5 golden-output tests for this module. This module is self-contained:
        it reads its flat-file fixture (data.txt) with java.io.BufferedReader over a
        classpath resource, so it needs no JDBC driver, no Spring Web/Data starter,
        and depends on no other cobol-* sub-module.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        finalName fixes the build artifact path to target/cobol-database-1.0.0.jar
        (identical to the default ${project.artifactId}-${project.version}). The
        spring-boot-maven-plugin is referenced without a version (managed by the
        parent) and without an executions block (the repackage goal is already
        bound in the parent's pluginManagement).

        DELIBERATE: this module configures no Spring Boot main class. cobol-database
        hosts four co-equal @SpringBootApplication entry classes (OpenFileRecordKey,
        OpenFileSequential, SequentialRead, StatusCode) with no single natural
        default, so designating any one of them as the Start-Class would be
        arbitrary. Spring Boot's repackage goal requires exactly one main class to
        build an executable fat-jar; rather than pin an arbitrary default, the
        repackage goal is skipped here (skip=true) and this module is built as a
        plain (non-executable) library JAR. Its reusable artifacts are the
        FileStatus enum (encoding the 30 COBOL FILE-STATUS codes) and the data.txt
        classpath fixture consumed by the four entry classes.
    -->
    <build>
        <finalName>cobol-database-1.0.0</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
