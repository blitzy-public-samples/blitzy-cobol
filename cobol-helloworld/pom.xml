<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherit from the cobol-parent aggregator POM. The parent supplies the
        Spring Boot 3.5.x BOM (via its own spring-boot-starter-parent), Java 21
        source/target/release, the zero-warning compiler policy (-Xlint:all
        -Werror -parameters), the UTF-8 surefire encoding and the pre-bound
        spring-boot-maven-plugin repackage goal. groupId and version are inherited
        from this parent and are therefore intentionally omitted below.
        relativePath resolves the parent from the repository root on the local
        filesystem rather than from a remote repository.
    -->
    <parent>
        <groupId>com.projectcobol</groupId>
        <artifactId>cobol-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cobol-helloworld</artifactId>
    <packaging>jar</packaging>

    <name>Project COBOL - HelloWorld</name>
    <description>
        Java 21 / Spring Boot 3.x translation of OpenCobol/HelloWorld.cbl,
        the canonical "Hello world!" smoke-test program in Project COBOL.
        Demonstrates the @SpringBootApplication + CommandLineRunner pattern
        that maps the COBOL PROCEDURE DIVISION / MAIN-PROCEDURE / GOBACK
        lifecycle onto a Spring Boot batch-style entry point.
    </description>

    <!--
        Exactly two dependencies, both BOM-managed (no explicit version): the core
        Spring Boot starter that provides SpringApplication, CommandLineRunner and
        the @SpringBootApplication auto-configuration used by HelloWorldApplication,
        and the test starter (JUnit Jupiter 5.12.x, AssertJ, Mockito, spring-boot-test)
        that backs the JUnit 5 golden-output test for this module. This module is
        self-contained: it adds no JDBC driver and depends on no other cobol-* sub-module.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        Single-entry-class module: cobol-helloworld contains exactly one
        @SpringBootApplication class, HelloWorldApplication. Its fully-qualified
        name is pinned here as the start-class property and wired into the
        spring-boot-maven-plugin mainClass below so the produced fat-jar declares a
        deterministic Start-Class in its manifest. The property can be overridden at
        build time (mvn ... -Dstart-class=...) without editing this POM.
    -->
    <properties>
        <start-class>com.projectcobol.helloworld.HelloWorldApplication</start-class>
    </properties>

    <!--
        finalName fixes the executable artifact path to
        target/cobol-helloworld-1.0.0.jar so the documented run command
        (java -jar cobol-helloworld/target/cobol-helloworld-1.0.0.jar) works. The
        spring-boot-maven-plugin is referenced without a version (managed by the
        parent) and without an executions block (the repackage goal is already bound
        in the parent's pluginManagement). mainClass is wired to the start-class
        property so the fat-jar's Start-Class is HelloWorldApplication.
    -->
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
